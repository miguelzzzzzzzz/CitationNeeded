# Copy to .env and adjust. Never commit a real .env file.
# All settings use the RAG_ prefix and are optional; defaults are shown.

# --- Ingestion ---
RAG_MAX_FILE_BYTES=20000000

# --- Chunking ---
# strategy: fixed | recursive | structure
RAG_CHUNK_STRATEGY=structure
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_MIN_CHUNK_TOKENS=16

# --- Embeddings (requires: pip install -e ".[embeddings]") ---
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_BATCH_SIZE=32
# Optional instruction prefix for queries (empty by default; evaluated in M4)
# RAG_EMBEDDING_QUERY_PREFIX=
# RAG_EMBEDDING_CACHE_DIR=
# RAG_EMBEDDING_THREADS=

# --- LLM provider (planned, milestone M5; not read by the code yet) ---
# Any OpenAI-compatible endpoint. Leave empty to use the extractive no-LLM answer path.
# RAG_LLM_BASE_URL=
# RAG_LLM_MODEL=
# RAG_LLM_API_KEY=<your-key-here>
